# ===== LLM 配置(OpenAI 兼容协议) =====
# 模型名称, 例如: gpt-4o-mini / deepseek-chat / qwen-plus / moonshot-v1-8k
LLM_MODEL_ID=gpt-4o-mini

# API 密钥
LLM_API_KEY=your-api-key-here

# 服务地址(OpenAI 官方: https://api.openai.com/v1)
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.openai.com/v1

# 采样温度(0-2, 越小越稳定)
LLM_TEMPERATURE=0.3

# 请求超时(秒)
LLM_TIMEOUT=90

# 失败重试次数
LLM_MAX_RETRIES=2

# 结构化输出模式: auto / json_schema / json_object / prompt
# auto 会自动在三种模式之间降级, 一般无需修改
LLM_STRUCTURED_MODE=auto

# 单个 Agent 允许的最大推理步数
LLM_MAX_STEPS=6

# ===== 服务器配置 =====
HOST=0.0.0.0
PORT=8000

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# ===== 高德地图 API 配置 =====
# https://console.amap.com/ 申请 Web 服务 Key
AMAP_API_KEY=your_amap_api_key_here

# 每天安排的景点数量
ATTRACTIONS_PER_DAY=3

# ===== MCP 模式(可选) =====
# true: 通过官方 MCP SDK 连接 amap-mcp-server, 工具清单由 list_tools() 动态生成
#       (需要本机具备 uv, 且能执行 `uvx amap-mcp-server`)
# false(默认): 直连高德 REST, 无额外进程依赖
# 连接失败会自动回落到 REST 直连
USE_MCP_AMAP=false
MCP_AMAP_COMMAND=uvx amap-mcp-server
MCP_AMAP_TIMEOUT=30

# ===== Unsplash API Credentials(可选, 用于景点配图) =====
UNSPLASH_ACCESS_KEY=""
UNSPLASH_SECRET_KEY=""
